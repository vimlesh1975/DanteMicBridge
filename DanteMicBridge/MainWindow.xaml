<Window x:Class="DanteMicBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dante Mic Bridge - Audio-over-IP (AES67 / Dante)" 
        Height="840" Width="1060" MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E14"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI, Segoe UI Variable, Inter, sans-serif">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#151922"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#252B3B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="HeaderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#7E8B9B"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Custom Solid Colored Level Meter -->
        <Style x:Key="VuMeterStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="#10131A" CornerRadius="4" BorderBrush="#202636" BorderThickness="1">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00E676" Offset="0.0"/>
                                            <GradientStop Color="#76FF03" Offset="0.6"/>
                                            <GradientStop Color="#FFEA00" Offset="0.85"/>
                                            <GradientStop Color="#FF1744" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1A8CD8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#005B99"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2A2F3D"/>
                                <Setter Property="Foreground" Value="#5C6479"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2A2F3D"/>
                                <Setter Property="Foreground" Value="#5C6479"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161B26"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A344A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Template for ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <Border x:Name="SplitBorder" Width="26" HorizontalAlignment="Right" Margin="0">
                    <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A0AEC0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#007ACC"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#007ACC"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#007ACC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="TemplateRoot" Property="Background" Value="#121620"/>
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#252C3D"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#4A5568"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Global ComboBox Style with Dark Popup -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161B26"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="10,4,30,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="true">
                            <ToggleButton x:Name="ToggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" 
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"/>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#F8FAFC"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="true" 
                                   IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" 
                                        Background="#11141D" 
                                        BorderBrush="#2D3748" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="4" 
                                        Margin="0,2,0,0" 
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="true">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="125"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#00E676" CornerRadius="3" Width="8" Height="22" Margin="0,0,10,0"/>
                    <TextBlock Text="AUDIO-OVER-IP (AoIP) / AES67 &amp; DANTE BRIDGE" FontSize="11" FontWeight="Bold" Foreground="#00E676" VerticalAlignment="Center"/>
                    <Border Background="#1C2230" CornerRadius="10" Margin="12,0,0,0" Padding="8,2">
                        <TextBlock x:Name="TxtSdkStatus" Text="AES67 Mode: Active (No License Required)" FontSize="11" Foreground="#00E676" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Analog Microphone to AES67 / Dante Network Streamer" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="BadgeDanteStatus" Background="#1E232E" CornerRadius="14" Padding="14,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#78909C" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="STANDBY" FontWeight="Bold" FontSize="11" Foreground="#ECEFF4"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Body Content (Scrollable if screen resolution is low) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Audio Device & Dante Config -->
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                <!-- Device Selection Card -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="ANALOG MICROPHONE INPUT (WASAPI Low-Latency)" Style="{StaticResource HeaderTitle}"/>
                        
                        <TextBlock Text="Input Capture Device:" Foreground="#9BA5B7" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbDevices" Height="34" Background="#1B202C" Foreground="#ECEFF4" BorderBrush="#30384D" VerticalContentAlignment="Center" Padding="8,4" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Sample Rate:" Foreground="#9BA5B7" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbSampleRate" Height="32" Background="#1B202C" Foreground="#ECEFF4" BorderBrush="#30384D" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="48,000 Hz (Dante Standard)" IsSelected="True"/>
                                    <ComboBoxItem Content="96,000 Hz (High-Res)"/>
                                    <ComboBoxItem Content="44,100 Hz"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Bit Depth:" Foreground="#9BA5B7" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbBitDepth" Height="32" Background="#1B202C" Foreground="#ECEFF4" BorderBrush="#30384D" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="24-bit PCM (Dante Standard)" IsSelected="True"/>
                                    <ComboBoxItem Content="32-bit Float"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Input Preamp / Gain Slider -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Software Preamp / Digital Boost:" Foreground="#9BA5B7" FontSize="12"/>
                            <TextBlock x:Name="TxtGainVal" Grid.Column="1" Text="2.00x (+6.0 dB)" Foreground="#00E5FF" FontWeight="SemiBold" FontSize="12"/>
                        </Grid>
                        <Slider x:Name="SliderGain" Minimum="0.5" Maximum="10.0" Value="2.0" TickFrequency="0.5" ValueChanged="SliderGain_ValueChanged"/>
                    </StackPanel>
                </Border>

                <!-- Dante / AES67 Stream Config Card -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="AUDIO-OVER-IP (AoIP) TRANSMITTER CONFIGURATION" Style="{StaticResource HeaderTitle}"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Transmission Mode:" Foreground="#9BA5B7" FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbProtocolMode" Height="32" Background="#1B202C" Foreground="#ECEFF4" BorderBrush="#30384D" VerticalContentAlignment="Center" SelectionChanged="CmbProtocolMode_SelectionChanged">
                                    <ComboBoxItem Content="VBAN LAN Direct (100% Free: Speak on PC1 -> Hear on PC2)" IsSelected="True"/>
                                    <ComboBoxItem Content="Dante Virtual Soundcard (Shows in Dante Controller)"/>
                                    <ComboBoxItem Content="AES67 / RTP Multicast (Open AoIP Standard)"/>
                                    <ComboBoxItem Content="Audinate DAL SDK (Commercial License)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Channel / Stream Name:" Foreground="#9BA5B7" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtTxChannel" Text="Stream1" Height="32" Background="#1B202C" Foreground="#ECEFF4" BorderBrush="#30384D" VerticalContentAlignment="Center" Padding="8,4"/>
                            </StackPanel>
                        </Grid>

                        <!-- VBAN Configuration Panel -->
                        <Grid Margin="0,0,0,12" x:Name="PanelVbanParams">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Target IP (e.g. 255.255.255.255 for broadcast or PC 2's IP):" Foreground="#9BA5B7" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtVbanIp" Text="255.255.255.255" Height="32" Background="#1B202C" Foreground="#ECEFF4" BorderBrush="#30384D" VerticalContentAlignment="Center" Padding="8,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="VBAN UDP Port:" Foreground="#9BA5B7" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtVbanPort" Text="6980" Height="32" Background="#1B202C" Foreground="#ECEFF4" BorderBrush="#30384D" VerticalContentAlignment="Center" Padding="8,4"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="PanelDvsParams" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="Dante Virtual Soundcard Output Device:" Foreground="#9BA5B7" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbDvsDevice" Height="32" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Mic L/R go to DVS Tx channels 1/2. Subscribe them in Dante Controller." Foreground="#64748B" FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12" x:Name="GridAes67Params" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="AES67 Multicast IP:" Foreground="#9BA5B7" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtMulticastIp" Text="239.69.1.1" Height="32" Background="#1B202C" Foreground="#ECEFF4" BorderBrush="#30384D" VerticalContentAlignment="Center" Padding="8,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="RTP Port:" Foreground="#9BA5B7" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtRtpPort" Text="5004" Height="32" Background="#1B202C" Foreground="#ECEFF4" BorderBrush="#30384D" VerticalContentAlignment="Center" Padding="8,4"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="BtnStart" Content="Start AoIP Stream" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Width="170" Click="BtnStart_Click"/>
                            <Button x:Name="BtnStop" Content="Stop Stream" Style="{StaticResource StopButton}" Width="130" IsEnabled="False" Click="BtnStop_Click"/>
                            <Button x:Name="BtnRefresh" Content="Refresh Devices" Background="#242B3A" Foreground="#ECEFF4" BorderThickness="0" Margin="10,0,0,0" Padding="12,9" Cursor="Hand" Click="BtnRefresh_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Column: VU Meters & Dante Network Status -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="REALTIME AUDIO METERS" Style="{StaticResource HeaderTitle}" Margin="0"/>
                            <TextBlock x:Name="TxtDbReadout" Grid.Column="1" Text="-inf dB" FontSize="11" FontWeight="Bold" Foreground="#00E676"/>
                        </Grid>

                        <!-- Meter Left -->
                        <TextBlock Text="Channel 1 (Left / Mic)" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ProgressBar x:Name="PbLevelL" Style="{StaticResource VuMeterStyle}" Margin="0,0,0,12"/>

                        <!-- Meter Right -->
                        <TextBlock Text="Channel 2 (Right / Auxiliary)" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <ProgressBar x:Name="PbLevelR" Style="{StaticResource VuMeterStyle}" Margin="0,0,0,14"/>

                        <!-- Network AoIP Broadcast Info -->
                        <Border Background="#10131A" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Network AoIP Status" FontSize="11" FontWeight="SemiBold" Foreground="#00E676" Margin="0,0,0,4"/>
                                <TextBlock Text="• Stream: AES67 L24 Stereo Multicast" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="• Dante Controller AES67 receiver compatible" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="• SAP Announce: 224.2.127.254:9875 (SDP)" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="• PTP / RTP RFC 3550 standard clock" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- SDK Integration Notes -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="COMPATIBILITY &amp; LICENSING" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock x:Name="TxtSdkExplanation" TextWrapping="Wrap" FontSize="11" Foreground="#9BA5B7" LineHeight="16">
                            AES67 mode is 100% royalty-free and open. In Dante Controller, enable AES67 mode on your Dante receiver devices to route this stream directly with zero license fees.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>

        <!-- Bottom Row: Diagnostic / Realtime Activity Log -->
        <Border Grid.Row="2" Background="#11141D" CornerRadius="8" BorderBrush="#202636" BorderThickness="1" Padding="12" Margin="0,6,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="CONSOLE &amp; DIAGNOSTIC ACTIVITY" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLogs" Background="Transparent" Foreground="#A0AEC0" BorderThickness="0" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" IsReadOnly="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
